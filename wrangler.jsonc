{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Poarta temporara de mentenanta ruleaza inaintea oricarui asset static.
  // Nu lasa rute sau fisiere accesibile fara autentificare.
  "name": "m-craft",
  "compatibility_date": "2026-10-23",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
